diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -4910,7 +4910,15 @@
 	mon_wdev->iftype = NL80211_IFTYPE_MONITOR;
 	mon_ndev->ieee80211_ptr = mon_wdev;
 
+	/* Must not be bare register_netdevice() here: this runs inside the
+	 * cfg80211 add_virtual_intf callback, which already holds wiphy->mtx,
+	 * and cfg80211's NETDEV_REGISTER notifier then takes that same mutex --
+	 * deadlock in D state, unkillable, holding RTNL. */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 12, 0))
+	ret = cfg80211_register_netdevice(mon_ndev);
+#else
 	ret = register_netdevice(mon_ndev);
+#endif
 	if (ret)
 		goto out;
 
@@ -5059,7 +5067,11 @@
 	 * because only monitor can be added
 	 */
 	if(wdev->iftype == NL80211_IFTYPE_MONITOR)
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 12, 0))
+		cfg80211_unregister_netdevice(ndev);
+#else
 		unregister_netdevice(ndev);
+#endif
 			pwdev_priv->pmon_ndev = NULL;
 			pwdev_priv->ifname_mon[0] = '\0';
 			RTW_INFO(FUNC_NDEV_FMT" remove monitor ndev\n", FUNC_NDEV_ARG(ndev));
@@ -9768,7 +9780,10 @@
 	wiphy->max_num_pmkids = RTW_MAX_NUM_PMKIDS;
 
 #if CONFIG_RTW_MACADDR_ACL && (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 9, 0))
-	wiphy->max_acl_mac_addrs = NUM_ACL;
+	/* Do not advertise MAC-ACL support: cfg80211 rejects a wiphy that sets
+	 * max_acl_mac_addrs without BOTH WIPHY_FLAG_HAVE_AP_SME and .set_mac_acl
+	 * (net/wireless/core.c), wiphy_register() returns -EINVAL and no wlanN
+	 * interface is ever created. MAC ACL only matters in AP mode. */
 #endif
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 38)) || defined(COMPAT_KERNEL_RELEASE)
